# ============================================================================
#  Paper-run profile
#
#  Purpose: find out whether live behaviour matches the backtest. NOT to make
#  money — see FINDINGS.md, which measured a mean expectancy of -0.134 R across
#  60 configurations and recommends against funding this.
#
#  These settings are the least-bad configuration from that sweep. Treat them
#  with suspicion: they are the top of 60 tries on 24 trades, which is exactly
#  what selection bias looks like. The point of running them on paper is to see
#  whether that result survives contact with live data. If paper results come in
#  far worse than +2.1%/month, the backtest was flattering it, and that is a
#  useful thing to learn for free.
#
#  Copy to .env, add your keys, and run `npm start`.
# ============================================================================

MODE=paper
NETWORK=mainnet          # real prices; paper mode sends no orders

BYBIT_API_KEY=
BYBIT_API_SECRET=

# Best-performing pair and timeframe from the sweep. 1H because every 15m
# configuration tested lost money to fees.
SYMBOLS=DOGEUSDT,SOLUSDT
INTERVAL=60
STRATEGY=meanrev

# Trade management that measured best: 2R target, breakeven at 1R, no trailing.
STOP_ATR_MULT=1.8
TAKE_PROFIT_R=2
BREAKEVEN_AT_R=1
TRAIL_ATR_MULT=0

# Same risk limits that would apply live, so the paper run is a fair rehearsal.
LEVERAGE=5
STARTING_EQUITY_USD=50
RISK_PER_TRADE_PCT=3
MAX_DAILY_LOSS_USD=15
EQUITY_FLOOR_USD=20
MAX_CONCURRENT_POSITIONS=1
MAX_TRADES_PER_DAY=6
MAX_CONSECUTIVE_LOSSES=3
COOLDOWN_MINUTES=120

TAKER_FEE_RATE=0.00055
SLIPPAGE_PCT=0.02

STATE_FILE=./data/paper-state.json
LOG_FILE=./data/paper.log
LOG_LEVEL=info
HEALTH_PORT=8080

# Optional: get told when it trades, without watching a terminal.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
