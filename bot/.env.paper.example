# ============================================================================
#  Paper-run profile
#
#  Purpose: find out whether live behaviour matches the backtest. NOT to make
#  money — see FINDINGS.md, which measured a mean expectancy of -0.134 R across
#  60 configurations and recommends against funding this.
#
#  These settings are the best-supported configuration from that sweep: trend
#  following on 12-hour bars, where expectancy was +0.214 R over 170 trades and
#  8 of 10 configurations were profitable. It is chosen for being a consistent
#  gradient across five timeframes with a mechanism behind it, not for being the
#  single best cell in the table — with ~100 configurations tested, the best
#  cell is noise.
#
#  Expect very few trades. 12H bars on five symbols produce something like one
#  or two entries a month. That is the trade-off that makes the expectancy
#  positive: fewer, longer trades pay the 0.11% round-trip fee less often.
#
#  Copy to .env, add your keys, and run `npm start`.
# ============================================================================

MODE=paper
NETWORK=mainnet          # real prices; paper mode sends no orders

BYBIT_API_KEY=
BYBIT_API_SECRET=

# Diversified across five symbols, because 12H bars trade rarely and a single
# pair would sit idle for months.
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,DOGEUSDT
INTERVAL=720
STRATEGY=trend

# Trade management that measured best: 2R target, breakeven at 1R, no trailing.
STOP_ATR_MULT=1.8
TAKE_PROFIT_R=2
BREAKEVEN_AT_R=1
TRAIL_ATR_MULT=0

# Same risk limits that would apply live, so the paper run is a fair rehearsal.
LEVERAGE=5
STARTING_EQUITY_USD=50
RISK_PER_TRADE_PCT=3
MAX_DAILY_LOSS_USD=15
EQUITY_FLOOR_USD=20
# Two at a time, so a second signal is not discarded while the first runs for
# days. Worst case is 6% of equity at risk, still well inside the daily stop.
MAX_CONCURRENT_POSITIONS=2
MAX_TRADES_PER_DAY=3
MAX_CONSECUTIVE_LOSSES=3
COOLDOWN_MINUTES=120

TAKER_FEE_RATE=0.00055
SLIPPAGE_PCT=0.02

STATE_FILE=./data/paper-state.json
LOG_FILE=./data/paper.log
LOG_LEVEL=info
HEALTH_PORT=8080

# Optional: get told when it trades, without watching a terminal.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
