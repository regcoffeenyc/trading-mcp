# ============================================================================
#  Paper-run profile
#
#  Purpose: find out whether live behaviour matches the backtest. NOT to make
#  money on $50 — see FINDINGS.md. At the measured rate, $50 returns a few
#  dollars a month and $250/month would need roughly $5,000.
#
#  These settings are the best-supported configuration measured: trend following
#  on 12-hour bars across 30 perpetuals, +0.253 R per trade over 316 trades, 19
#  of 30 symbols positive. Chosen because the edge held as the universe widened,
#  which is the opposite of what overfitting does — not because any single row
#  looked good.
#
#  Read FINDINGS.md before trusting it. The measurement carries survivorship
#  bias: it covers coins that still exist, not the ones that died. Expect live
#  results below the backtest.
#
#  Copy to .env, add your keys, and run `npm start`.
# ============================================================================

MODE=paper
NETWORK=mainnet          # real prices; paper mode sends no orders

BYBIT_API_KEY=
BYBIT_API_SECRET=

# Thirty established perpetuals. The wide universe is what makes the strategy
# work at all: 12H bars produce roughly one entry per symbol per quarter, so
# five symbols would trade ~14 times a year — too rarely to learn anything from
# a paper run, and too rarely to compound. Thirty gives ~7 entries a month.
# Trim any your Bybit account cannot trade; `npm run doctor` reports which.
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,BNBUSDT,ADAUSDT,AVAXUSDT,LINKUSDT,DOTUSDT,LTCUSDT,BCHUSDT,NEARUSDT,UNIUSDT,ATOMUSDT,FILUSDT,APTUSDT,ARBUSDT,OPUSDT,SUIUSDT,TRXUSDT,ETCUSDT,INJUSDT,TIAUSDT,SEIUSDT,PEPEUSDT,WLDUSDT,AAVEUSDT,ICPUSDT,LDOUSDT
INTERVAL=720
STRATEGY=trend

# Trade management that measured best: 2R target, breakeven at 1R, no trailing.
# Wider stop and target than the short-timeframe defaults: once fees stop
# dominating, letting winners run pays, which is what trend theory predicts.
STOP_ATR_MULT=2.5
TAKE_PROFIT_R=3
BREAKEVEN_AT_R=1
TRAIL_ATR_MULT=0

# Same risk limits that would apply live, so the paper run is a fair rehearsal.
LEVERAGE=5
STARTING_EQUITY_USD=50
RISK_PER_TRADE_PCT=3
MAX_DAILY_LOSS_USD=15
EQUITY_FLOOR_USD=20
# Three at a time. 12H trades run for days, so with too few slots the bot simply
# misses signals and the measured edge never materialises. Three is a
# compromise: crypto is highly correlated, so three open positions is not real
# diversification, and the worst case is 9% of equity at risk at once — still
# inside the daily stop, but do not raise this casually.
MAX_CONCURRENT_POSITIONS=3
MAX_TRADES_PER_DAY=3
MAX_CONSECUTIVE_LOSSES=3
COOLDOWN_MINUTES=120

TAKER_FEE_RATE=0.00055
SLIPPAGE_PCT=0.02

STATE_FILE=./data/paper-state.json
LOG_FILE=./data/paper.log
LOG_LEVEL=info
HEALTH_PORT=8080

# Optional: get told when it trades, without watching a terminal.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
