# ============================================================================
#  Bybit trading bot — configuration
#  Copy to .env and edit. Never commit .env: it holds your API secret.
# ============================================================================

# --- Mode -------------------------------------------------------------------
# paper = simulated fills against the live market feed (no orders sent)
# live  = real orders on Bybit
MODE=paper

# mainnet | testnet | demo
# Start on testnet or demo. Move to mainnet only after a paper run you believe.
NETWORK=testnet

# --- Credentials ------------------------------------------------------------
# Create at bybit.com -> API -> System-generated. Permissions: "Contract - Trade"
# and "Read". NEVER enable withdrawal. Restrict to your server's IP.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_RECV_WINDOW=5000

# Optional: use a different Bybit domain if api.bybit.com is blocked in your
# region, e.g. https://api.bytick.com
# BYBIT_REST_HOST=

# --- Market -----------------------------------------------------------------
# USDT perpetuals. With a $50 account, prefer symbols whose $5 minimum order is
# a small fraction of your risk budget. Run `npm run doctor` to check.
SYMBOLS=SOLUSDT,XRPUSDT,DOGEUSDT

# Candle interval in minutes: 1, 3, 5, 15, 30, 60, 240, D
# Default is 60. Every 15m configuration tested lost money (see FINDINGS.md):
# a round trip costs 0.11% of notional whatever the timeframe, so shorter bars
# pay the same toll for a smaller move.
INTERVAL=60

# trend   = EMA cross + ADX + EMA200 filter (fewer trades, larger winners)
# meanrev = Bollinger fade in a range regime (more trades, smaller winners)
STRATEGY=trend

LEVERAGE=5

# --- Risk limits ------------------------------------------------------------
# Your account size. Used for sizing before the first balance read.
STARTING_EQUITY_USD=50

# Percent of equity risked per trade (the distance to the stop, not the notional).
RISK_PER_TRADE_PCT=3

# Hard stop: stop trading for the day once down this much, measured mark-to-market
# against the equity at the start of the trading day.
MAX_DAILY_LOSS_USD=15

# Optional: also stop once up this much on the day. 0 disables.
MAX_DAILY_PROFIT_USD=0

# Permanent halt if equity ever falls to this level. Requires manual restart.
EQUITY_FLOOR_USD=20

MAX_CONCURRENT_POSITIONS=1
MAX_TRADES_PER_DAY=6
MAX_CONSECUTIVE_LOSSES=3
COOLDOWN_MINUTES=120

# Hour (UTC) at which the trading day rolls and the daily loss counter resets.
DAY_RESET_HOUR_UTC=0

# Close open positions when the daily stop trips.
FLATTEN_ON_DAILY_STOP=true

# --- Trade management -------------------------------------------------------
STOP_ATR_MULT=1.8         # stop distance in ATRs
TAKE_PROFIT_R=2           # target as a multiple of the risked distance
BREAKEVEN_AT_R=1          # move the stop to breakeven after this much profit
TRAIL_ATR_MULT=0          # >0 enables an ATR trailing stop after breakeven
MAX_SPREAD_PCT=0.06       # skip entries when the book is wider than this
MIN_ATR_PCT=0.15          # skip entries when volatility is too low to pay fees
MAX_HOLD_MINUTES=720      # force-close a stale position (0 disables)

# Bybit taker fee (0.055% standard). Used for sizing, breakeven and backtests.
TAKER_FEE_RATE=0.00055
SLIPPAGE_PCT=0.02

# --- Operations -------------------------------------------------------------
STATE_FILE=./data/state.json
LOG_LEVEL=info
LOG_FILE=./data/bot.log

# Serve GET /health for uptime monitoring. 0 disables.
HEALTH_PORT=8080

# Optional Telegram alerts on entries, exits and halts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Backtest only ----------------------------------------------------------
BACKTEST_BARS=5000
# BACKTEST_SYMBOLS=SOLUSDT,XRPUSDT
